Source: "memory.inc"
                            	     1: ; vim:noet:sw=8:ts=8:sts=8:ai:syn=asm68k
                            	     2: 
                            	     3: ROMSIZE         equ     $010000 ;64KB
                            	     4: RAMSIZE         equ     $100000 ;1MB
                            	     5: ;RAMSIZE         equ     $080000 ;512kB
                            	     6: RAMEND          equ     RAM+RAMSIZE
                            	     7: INITIAL_SP      equ     RAMEND
                            	     8: ;-------------------------------------------------------------------------------
                            	     9: ; Base addresses
                            	    10: ROM             equ     $000000
                            	    11: RAM             equ     $E00000
                            	    12: ;-------------------------------------------------------------------------------
                            	    13: ; Memory reserved for the system
                            	    14: SYSMEMSTART     equ     RAM
                            	    15: SYSMEMSIZE      equ     256
                            	    16:                 rsset	SYSMEMSTART
                            	    17: OUTCH_VEC       rs.l    1
                            	    18: INCH_VEC        rs.l    1
                            	    19: HEXDIGITS       rs.l    1
                            	    20: SEPARATORS      rs.l    1
                            	    21: DATE_SEP        equ     SEPARATORS
                            	    22: TIME_SEP        equ     SEPARATORS+1
                            	    23: THOUSANDS_SEP   equ     SEPARATORS+2
                            	    24: 
                            	    25: ; Mounted filesystem parameters
                            	    26: PARTSIZE        rs.l    1               ; size of the partition in sectors, 0 = not mounted (4 bytes)
                            	    27: BPBSECTOR       rs.l    1               ; sector number of the partition's BIOS Parameter Block (4 bytes)
                            	    28: ; These parameters are in reverse order of those in the BPB,
                            	    29: ; because they are little-endian quantities that need to be byte-swapped
                            	    30: FATSIZE         rs.w    1               ; size of a FAT in sectors (2 bytes)
                            	    31: MAXRDIRENTS     rs.w    1               ; maximum number of root directory entries (2 bytes)
                            	    32: FATCOPIES       rs.w    1               ; number of FATs (padded to 2 bytes)
                            	    33: RSVDSECTORS     rs.w    1               ; number of reserved sectors (2 bytes)
                            	    34: CLUSTERSIZE     rs.w    1               ; number of sectors per cluster (2 bytes)
                            	    35: RDIRSECTOR      rs.l    1               ; sector number of root directory table (4 bytes)
                            	    36: FATSECTOR       rs.l    1               ; sector number of FAT #1 (4 bytes)
                            	    37: DATASTART       rs.l    1               ; sector number of data region start (4 bytes)
                            	    38: VOLNAME         rs.b    12              ; volume label (11 bytes, one extra for padding)
                            	    39: FSVARSTART      equ     PARTSIZE
                            	    40: FSVARLEN        equ     VOLNAME-FSVARSTART+12
                            	    41: 
                            	    42: INPUTBUFLEN     equ     64
                            	    43: INPUTBUF        rs.b    INPUTBUFLEN+2   ; command input buffer
                            	    44: 
                            	    45: ;-------------------------------------------------------------------------------
                            	    46: ; Application programs can be loaded here
                            	    47: APPMEMSTART    equ     SYSMEMSTART+SYSMEMSIZE
                            	    48: 

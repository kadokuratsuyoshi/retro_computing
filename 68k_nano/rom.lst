                            	 10059: ;   Sarryl	ds.l	1			* start of arrays		(end of strings)
                            	 10060: ;   Earryl	ds.l	1			* end of arrays		(start of free mem)
                            	 10061: ;   Sstorl	ds.l	1			* string storage		(moving down)
                            	 10062: ;   Ememl		ds.l	1			* end of memory		(upper bound of RAM)

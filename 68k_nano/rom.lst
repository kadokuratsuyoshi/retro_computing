                            	  1612: 
                            	  1613: ; Start a SPI transfer by asserting chip select.
                            	  1614: ; Arguments:    none
                            	  1615: ; Returns:      none
02:00001110 43F900A00008    	  1616: spi_startxfer:  lea.l   UART+MCR,a1
02:00001116 08910002        	  1617:                 bclr.b  #MCR_CLK,(a1)   ; clock starts high
02:0000111A 08D10003        	  1618:                 bset.b  #MCR_nSS,(a1)   ; chip select asserted
02:0000111E 4E75            	  1619:                 rts
                            	  1620: 
                            	  1621: ; End a SPI transfer by de-asserting chip select.
                            	  1622: ; Arguments:    none
                            	  1623: ; Returns:      none
02:00001120 43F900A00008    	  1624: spi_endxfer:    lea.l   UART+MCR,a1
02:00001126 08910003        	  1625:                 bclr.b  #MCR_nSS,(a1)   ; chip select deasserted
02:0000112A 4E75            	  1626:                 rts
                            	  1627: 
                            	  1628: ; Perform a 1-byte SPI data transfer.
                            	  1629: ; Arguments:    d0.b - data byte to shift out
                            	  1630: ; Returns:      d0.b - data byte shifted in
                            	  1631: spi_shiftbyte:  push    d2
                            	     1M         if NARG>1
                            	     2M         fail    multiple args passed to push--use pushm if you want to push multiple registers
                            	     3M         endif
02:0000112C 2F02            	     4M                 move.l  d2,-(sp)
02:0000112E 43F900A00008    	  1632:                 lea.l   UART+MCR,a1
02:00001134 1411            	  1633:                 move.b  (a1),d2         ; use d2 as a temporary for MCR write operations
02:00001136 E20A            	  1634:                 lsr.b   #1,d2           ; delete bit 0 so we can shift our COPI bit in
02:00001138 4600            	  1635:                 not.b   d0              ; invert data byte to match MCR's inverted polarity
02:0000113A 7207            	  1636:                 moveq   #7,d1           ; eight bits
02:0000113C E310            	  1637: .bitloop:       roxl.b  #1,d0                   ; get data bit to send
02:0000113E E312            	  1638:                 roxl.b  #1,d2                   ; and rotate it into the COPI bit
02:00001140 5802            	  1639:                 addq.b  #(1<<MCR_CLK),d2        ; clock falling edge
02:00001142 1282            	  1640:                 move.b  d2,(a1)
02:00001144 5902            	  1641:                 subq.b  #(1<<MCR_CLK),d2        ; clock rising edge
02:00001146 1282            	  1642:                 move.b  d2,(a1)
02:00001148 E20A            	  1643:                 lsr.b   #1,d2           ; delete old COPI bit value
02:0000114A 4842            	  1644:                 swap    d2
02:0000114C 14290004        	  1645:                 move.b  4(a1),d2        ; read CIPO bit from MSR (2 words past MCR)
02:00001150 E30A            	  1646:                 lsl.b   #1,d2           ; rotate CIPO bit into X flag
02:00001152 4842            	  1647:                 swap    d2
02:00001154 51C9FFE6        	  1648:                 dbra    d1,.bitloop
02:00001158 E310            	  1649:                 roxl.b  #1,d0           ; rotate in the last bit received
02:0000115A 4600            	  1650:                 not.b   d0              ; invert CIPO bits
                            	  1651:                 pop     d2
                            	     1M         if NARG>1
                            	     2M         fail    multiple args passed to pop--use popm if you want to pop multiple registers
                            	     3M         endif

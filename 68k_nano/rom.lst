                            	 10065: ;   Blinel	ds.l	1			* break line		(Basic line number)
                            	 10066: ;   
                            	 10067: ;   Cpntrl	ds.l	1			* continue pointer
                            	 10068: ;   Dlinel	ds.l	1			* current DATA line

                            	  9874: 
                            	  9875: *************************************************************************************
                            	  9876: * EhBASIC keywords quick reference list								*
                            	  9877: *************************************************************************************
                            	  9878: 
                            	  9879: * glossary
                            	  9880: 
                            	  9881: 	* <.>		  required
                            	  9882: 	* {.|.}	  one of required
                            	  9883: 	* [.]		  optional
                            	  9884: 	* ...		  may repeat as last
                            	  9885: 
                            	  9886: 	* any		= anything
                            	  9887: 	* num		= number
                            	  9888: 	* state	= statement
                            	  9889: 	* pint	= positive integer
                            	  9890: 	* str		= string
                            	  9891: 	* var		= variable
                            	  9892: 	* nvar	= numeric variable
                            	  9893: 	* svar	= string variable
                            	  9894: 	* expr	= expression
                            	  9895: 	* nexpr	= numeric expression
                            	  9896: 	* sexpr	= string expression
                            	  9897: 
                            	  9898: * statement separator
                            	  9899: 
                            	  9900: * :		. [state] : [state]						* done
                            	  9901: 
                            	  9902: * number bases
                            	  9903: 
                            	  9904: * %		. %<binary num>							* done
                            	  9905: * $		. $<hex num>							* done
                            	  9906: 
                            	  9907: * commands
                            	  9908: 
                            	  9909: * END		. END									* done
                            	  9910: * FOR		. FOR <nvar>=<nexpr> TO <nexpr> [STEP <nexpr>]		* done
                            	  9911: * NEXT	. NEXT [<nvar>[,<nvar>]...]					* done
                            	  9912: * DATA	. DATA [{num|["]str["]}[,{num|["]str["]}]...]		* done
                            	  9913: * INPUT	. INPUT [<">str<">;] <var>[,<var>[,<var>]...]		* done
                            	  9914: * DIM		. DIM <var>(<nexpr>[,<nexpr>[,<nexpr>]])			* done
                            	  9915: * READ	. READ <var>[,<var>[,<var>]...]				* done
                            	  9916: * LET		. [LET] <var>=<expr>						* done
                            	  9917: * DEC		. DEC <nvar>[,<nvar>[,<nvar>]...]				* done
                            	  9918: * GOTO	. GOTO <pint>							* done
                            	  9919: * RUN		. RUN [pint]							* done
                            	  9920: * IF		. IF <nexpr> {THEN {pint|state}|GOTO <pint>}		* done
                            	  9921: * RESTORE	. RESTORE [pint]							* done
                            	  9922: * GOSUB	. GOSUB <pint>							* done
                            	  9923: * REM		. REM [any]								* done
                            	  9924: * STOP	. STOP								* done
                            	  9925: * ON		. ON <nexpr> {GOTO|GOSUB} <pint>[,<pint>[,<pint>]...]	* done
                            	  9926: * NULL	. NULL <nexpr>							* done
                            	  9927: * INC		. INC <nvar>[,<nvar>[,<nvar>]...]				* done
                            	  9928: * WAIT	. WAIT <nexpr>,<nexpr>[,<nexpr>]				* done
                            	  9929: * LOAD	. LOAD <sexpr>							* done for simulator
                            	  9930: * SAVE	. SAVE <sexpr>							* done for simulator
                            	  9931: * DEF		. DEF FN<var>(<var>)=<expr>					* done
                            	  9932: * POKE	. POKE <nexpr>,<nexpr>						* done
                            	  9933: * DOKE	. DOKE <nexpr>,<nexpr>					 	* done
                            	  9934: * LOKE	. LOKE <nexpr>,<nexpr>					 	* done
                            	  9935: * CALL	. CALL <nexpr>							* done
                            	  9936: * DO		. DO									* done
                            	  9937: * LOOP	. LOOP [{WHILE|UNTIL}<nexpr>]					* done
                            	  9938: * PRINT	. PRINT [{;|,}][expr][{;|,}[expr][{;|,}[expr]]...]	* done
                            	  9939: * CONT	. CONT								* done
                            	  9940: * LIST	. LIST [pint][-pint]						* done
                            	  9941: * CLEAR	. CLEAR								* done
                            	  9942: * NEW		. NEW									* done
                            	  9943: * WIDTH	. WIDTH [<pint>][,<pint>]					* done
                            	  9944: * GET		. GET <var>								* done
                            	  9945: * SWAP	. SWAP <var>,<var>						* done
                            	  9946: * BITSET	. BITSET <nexpr>,<nexpr>					* done
                            	  9947: * BITCLR	. BITCLR <nexpr>,<nexpr>					* done
                            	  9948: 
                            	  9949: * sub commands (may not start a statement)
                            	  9950: 
                            	  9951: * TAB		. TAB(<nexpr>)							* done
                            	  9952: * TO		. FOR <nvar>=<nexpr> TO <nexpr> [STEP <nexpr>]		* done
                            	  9953: * FN		. FN<var>(<expr>)							* done
                            	  9954: * SPC		. SPC(<nexpr>)							* done
                            	  9955: * THEN	. IF <nexpr> {THEN {pint|comm}|GOTO <pint>}		* done
                            	  9956: * NOT		. NOT <nexpr>							* done
                            	  9957: * STEP	. FOR <nvar>=<nexpr> TO <nexpr> [STEP <nexpr>]		* done
                            	  9958: * UNTIL	. LOOP [{WHILE|UNTIL}<nexpr>]					* done
                            	  9959: * WHILE	. LOOP [{WHILE|UNTIL}<nexpr>]					* done
                            	  9960: 
                            	  9961: * operators
                            	  9962: 
                            	  9963: * +		. [expr] + <expr>							* done
                            	  9964: * -		. [nexpr] - <nexpr>						* done
                            	  9965: * *		. <nexpr> * <nexpr>						* done fast hardware
                            	  9966: * /		. <nexpr> / <nexpr>						* done fast hardware
                            	  9967: * ^		. <nexpr> ^ <nexpr>						* done
                            	  9968: * AND		. <nexpr> AND <nexpr>						* done
                            	  9969: * EOR		. <nexpr> EOR <nexpr>						* done
                            	  9970: * OR		. <nexpr> OR <nexpr>						* done
                            	  9971: * >>		. <nexpr> >> <nexpr>						* done
                            	  9972: * <<		. <nexpr> << <nexpr>						* done
                            	  9973: 

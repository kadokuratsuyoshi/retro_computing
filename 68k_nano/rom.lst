                            	    10: 
                            	    11: BAUD_DIV        equ     (((F_CPU*10)/(16*BAUD))+5)/10 ; compute one extra decimal place and round
                            	    12: BAUD_DIV_L      equ     (BAUD_DIV&$FF)
                            	    13: BAUD_DIV_U      equ     ((BAUD_DIV>>8)&$FF)

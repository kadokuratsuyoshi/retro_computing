                            	  1684: ;-------------------------------------------------------------------------------
                            	  1685: ; Serial loader. Entered by UART interrupt
                            	  1686: ;-------------------------------------------------------------------------------
                            	  1687: ; Enter serial loader
                            	  1688: VEC_AUTOVEC1:
02:000011AA 43F900A00000    	  1689:                 lea.l   UART,a1
02:000011B0 08290004000A    	  1690:                 btst.b  #4,LSR(a1)      ; was this a break interrupt?
02:000011B6 6602            	  1691:                 bne     .1              ; if not, just return
02:000011B8 4E73            	  1692:                 rte
                            	  1693: ; wait for the break condition to deassert
02:000011BA 08290004000A    	  1694: .1:             btst.b  #4,LSR(a1)
02:000011C0 66F8            	  1695:                 bne     .1
                            	  1696: ; the break stuffs a zero byte into the fifo, remove it
02:000011C2 1011            	  1697:                 move.b  RHR(a1),d0
                            	  1698: ; acknowledge with 'U'
                            	  1699:                 tx_wait a1
02:000011C4 08290005000A    	     1M .t_000100:          btst.b  #5,LSR(a1)
02:000011CA 67F8            	     2M                 beq     .t_000100
02:000011CC 12BC0055        	  1700:                 move.b  #'U',THR(a1)
                            	  1701: ; now we're in the loader
02:000011D0 41F900E00100    	  1702:                 lea.l   APPMEMSTART,a0  ; starting RAM address
02:000011D6 7200            	  1703:                 moveq   #0,d1           ; byte counter
                            	  1704: ; receive characters in a loop and write them to RAM
02:000011D8 1029000A        	  1705: .byteloop:      move.b  LSR(a1),d0      ; wait for a character or a break from host
02:000011DC 08000004        	  1706:                 btst.l  #4,d0           ; break received?
02:000011E0 6614            	  1707:                 bne     .done           ; done with transfer
02:000011E2 08000000        	  1708:                 btst.l  #0,d0           ; character received?
02:000011E6 67F0            	  1709:                 beq     .byteloop
02:000011E8 10D1            	  1710:                 move.b  RHR(a1),(a0)+   ; receive byte and write to RAM
02:000011EA 5201            	  1711:                 addq.b  #1,d1           ; increment byte count
02:000011EC 66EA            	  1712:                 bne     .byteloop
02:000011EE 086900010008    	  1713:                 bchg.b  #MCR_LED,MCR(a1) ; flash LED every 256 bytes (each time byte count lsb is zero)
02:000011F4 60E2            	  1714:                 bra     .byteloop
                            	  1715: .done:
                            	  1716: ; wait for the break condition to deassert
02:000011F6 08290004000A    	  1717: .2:             btst.b  #4,LSR(a1)
02:000011FC 66F8            	  1718:                 bne     .2
                            	  1719: ; the break stuffs a zero byte into the fifo, remove it
02:000011FE 1011            	  1720:                 move.b  RHR(a1),d0
